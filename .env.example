# Ethereum RPC URL. If unset, built-in public fallbacks are used (read-only).
RPC_URL=
# Optional Merkl API base. Defaults to https://api.merkl.xyz
MERKL_API_URL=
# Optional public maker address for canary preview gas estimation.
# NEVER put a private key here or anywhere in this repository.
MAKER_ADDRESS=
# Optional public wallet address used as the PRIMARY read-only shadow capital
# source (V1.5). Balances are READ ONLY; no signing/broadcast.
WALLET_ADDRESS=
# Wallet-relative research fractions of deployableWalletCapitalUsd (finite, >0, <=1, unique, sorted).
SHADOW_WALLET_CAPITAL_FRACTIONS=0.10,0.25,0.50,0.75,1.00
# Hypothetical capacity multipliers relative to deployableWalletCapitalUsd (>1, unique, sorted).
SHADOW_CAPACITY_MULTIPLIERS=1.5,2.0,4.0
# OPTIONAL deterministic absolute capital grid for tests/fixtures/debug ONLY
# (SYNTHETIC_TEST). NOT the production default capital source.
SHADOW_SYNTHETIC_CAPITAL_GRID_USD=
# USD reserves excluded from deployable strategy capital.
GAS_RESERVE_USD=
EMERGENCY_RESERVE_USD=
# Optional read-only Chainlink feed overrides (addresses).
CHAINLINK_1INCH_USD=
CHAINLINK_ETH_USD=
# Data directory (defaults to ./data)
DATA_DIR=
# Log level: error|warn|info|debug
LOG_LEVEL=info
